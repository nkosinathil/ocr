APP_NAME=OCR Platform
APP_ENV=development
APP_DEBUG=true
APP_URL=http://192.168.1.66
APP_SECRET=ocr_platform_secret_key_2024_change_in_production

# Keycloak SSO (gint realm)
SSO_SERVER_URL=http://192.168.1.59
SSO_REALM=gint
SSO_CLIENT_ID=gint-ocr-platform
SSO_CLIENT_SECRET=WILL_BE_SET_AFTER_CLIENT_REGISTRATION
SSO_REDIRECT_URI=http://192.168.1.66/auth/callback
SSO_LOGOUT_URI=http://192.168.1.66/auth/logout

# Keycloak OIDC Endpoints (derived from realm, but explicit for clarity)
SSO_AUTH_ENDPOINT=http://192.168.1.59/realms/gint/protocol/openid-connect/auth
SSO_TOKEN_ENDPOINT=http://192.168.1.59/realms/gint/protocol/openid-connect/token
SSO_USERINFO_ENDPOINT=http://192.168.1.59/realms/gint/protocol/openid-connect/userinfo
SSO_LOGOUT_ENDPOINT=http://192.168.1.59/realms/gint/protocol/openid-connect/logout
SSO_INTROSPECT_ENDPOINT=http://192.168.1.59/realms/gint/protocol/openid-connect/token/introspect
SSO_JWKS_URI=http://192.168.1.59/realms/gint/protocol/openid-connect/certs
SSO_REVOKE_ENDPOINT=http://192.168.1.59/realms/gint/protocol/openid-connect/revoke

# Python Backend (OCR API on port 8001 — MxA uses 8000)
PYTHON_API_BASE_URL=http://192.168.1.90:8001
PYTHON_API_VERSION=v1
PYTHON_API_TIMEOUT=30

# PostgreSQL (local — will be installed on this server)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ocr_platform
DB_USER=ocr_app
DB_PASSWORD=ocr_secure_password_2024

# File Upload
MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,tiff,bmp,webp
