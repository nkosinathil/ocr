# ============================================================================
# MXA OCR - PHP Application Environment Configuration
# ============================================================================
# Product: MXA OCR
# This file contains environment-specific configuration.
# Copy this file to .env and update with your actual values.
# NEVER commit .env files to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_NAME="MXA OCR"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ocr.gismartanalytics.com
APP_TIMEZONE=Africa/Johannesburg

# ----------------------------------------------------------------------------
# Database (PostgreSQL on App Server)
# ----------------------------------------------------------------------------
DB_HOST=192.168.1.66
DB_PORT=5432
DB_DATABASE=mxa_ocr
DB_USERNAME=mxa_ocr_user
DB_PASSWORD=5ucc3SS!@#s
DB_CHARSET=utf8

# ----------------------------------------------------------------------------
# Keycloak SSO Authentication
# ----------------------------------------------------------------------------
KEYCLOAK_URL=http://192.168.1.59:8080
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=mxa-ocr-web
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret-here
KEYCLOAK_REDIRECT_URI=https://ocr.gismartanalytics.com/auth/callback

# ----------------------------------------------------------------------------
# Python Backend API
# ----------------------------------------------------------------------------
PYTHON_API_URL=http://192.168.1.90:8100
PYTHON_API_TIMEOUT=30
PYTHON_API_KEY=optional-api-key-if-needed

# ----------------------------------------------------------------------------
# MinIO Object Storage
# ----------------------------------------------------------------------------
MINIO_ENDPOINT=192.168.1.90:9000
MINIO_ACCESS_KEY=minio-access-key
MINIO_SECRET_KEY=minio-secret-key
MINIO_BUCKET_INPUT=mxa-ocr-input
MINIO_BUCKET_OUTPUT=mxa-ocr-output
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# ----------------------------------------------------------------------------
# Session Management
# ----------------------------------------------------------------------------
SESSION_LIFETIME=1800
SESSION_DRIVER=file
SESSION_PATH=../storage/sessions
SESSION_COOKIE_NAME=mxa_ocr_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
APP_KEY=your-32-character-random-key-here
CSRF_TOKEN_NAME=mxa_ocr_csrf_token
PASSWORD_PEPPER=your-pepper-string-here

# ----------------------------------------------------------------------------
# File Upload Limits
# ----------------------------------------------------------------------------
UPLOAD_MAX_SIZE=52428800
UPLOAD_ALLOWED_TYPES=application/pdf,image/png,image/jpeg,image/tiff
UPLOAD_TEMP_DIR=../storage/uploads

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_PATH=../storage/logs/app.log
LOG_MAX_FILES=30

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
FEATURE_REGISTRATION_ENABLED=false
FEATURE_BATCH_UPLOAD=true
FEATURE_API_ACCESS=false

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# ----------------------------------------------------------------------------
# Cache (Optional - for future use)
# ----------------------------------------------------------------------------
CACHE_DRIVER=file
CACHE_PATH=../storage/cache
CACHE_DEFAULT_TTL=3600

# ============================================================================
# IMPORTANT NOTES
# ============================================================================
# 1. This configuration is ONLY for the MXA OCR product
# 2. Do not share these values with other products
# 3. Change all passwords and secrets before deploying to production
# 4. Ensure file permissions are restrictive (chmod 600 .env)
# 5. Backup this file securely
# ============================================================================
