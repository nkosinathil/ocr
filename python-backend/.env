APP_NAME=OCR Processing Engine
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# PostgreSQL (on PHP server)
DATABASE_HOST=192.168.1.66
DATABASE_PORT=5432
DATABASE_NAME=ocr_platform
DATABASE_USER=ocr_app
DATABASE_PASSWORD=ocr_secure_password_2024

# Redis (local)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# MinIO (local)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_UPLOADS=ocr-uploads
MINIO_BUCKET_RESULTS=ocr-results
MINIO_USE_SSL=false

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# SSO
SSO_SERVER_URL=http://192.168.1.59
SSO_TOKEN_VERIFY_URL=http://192.168.1.59/api/token/verify

# CORS
CORS_ORIGINS=http://192.168.1.66,http://192.168.1.66:80

# Tesseract
TESSERACT_CMD=/usr/bin/tesseract
