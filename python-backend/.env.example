APP_NAME=OCR Processing Engine
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8001

# PostgreSQL (on Application Server)
DATABASE_HOST=192.168.1.66
DATABASE_PORT=5432
DATABASE_NAME=ocr_platform
DATABASE_USER=ocr_app
DATABASE_PASSWORD=change_me

# Redis (shared host, isolated databases — MxA uses 0/1, OCR uses 2/3)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=2

# MinIO (shared instance, separate buckets)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=mxaadmin
MINIO_SECRET_KEY=change_me
MINIO_BUCKET_UPLOADS=ocr-uploads
MINIO_BUCKET_RESULTS=ocr-results
MINIO_USE_SSL=false

# Celery (isolated Redis databases)
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3

# SSO (Keycloak)
SSO_SERVER_URL=http://192.168.1.59
SSO_TOKEN_VERIFY_URL=http://192.168.1.59/realms/gint/protocol/openid-connect/token/introspect
SSO_JWKS_URI=http://192.168.1.59/realms/gint/protocol/openid-connect/certs

# CORS
CORS_ORIGINS=http://192.168.1.66,http://192.168.1.90

# Tesseract
TESSERACT_CMD=/usr/bin/tesseract
