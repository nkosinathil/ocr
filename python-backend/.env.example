# ============================================================================
# MXA OCR - Python Backend Environment Configuration
# ============================================================================
# Product: MXA OCR
# This file contains environment-specific configuration.
# Copy this file to .env and update with your actual values.
# NEVER commit .env files to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_NAME=MXA OCR Backend
APP_ENV=production
APP_DEBUG=False
APP_HOST=0.0.0.0
APP_PORT=8100
APP_WORKERS=4

# ----------------------------------------------------------------------------
# Database (PostgreSQL on App Server)
# ----------------------------------------------------------------------------
DB_HOST=192.168.1.66
DB_PORT=5432
DB_NAME=mxa_ocr
DB_USER=mxa_ocr_user
DB_PASSWORD=5ucc3SS!@#s
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ----------------------------------------------------------------------------
# Redis (Task Queue and Cache)
# ----------------------------------------------------------------------------
REDIS_HOST=192.168.1.90
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_RESULT_BACKEND_DB=1

# ----------------------------------------------------------------------------
# Celery Configuration
# ----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://192.168.1.90:6379/0
CELERY_RESULT_BACKEND=redis://192.168.1.90:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT='["json"]'
CELERY_TIMEZONE=Africa/Johannesburg
CELERY_ENABLE_UTC=True
CELERY_TASK_TRACK_STARTED=True
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_QUEUE_NAME=mxa_ocr

# ----------------------------------------------------------------------------
# MinIO Object Storage
# ----------------------------------------------------------------------------
MINIO_ENDPOINT=192.168.1.90:9000
MINIO_ACCESS_KEY=minio-access-key
MINIO_SECRET_KEY=minio-secret-key
MINIO_BUCKET_INPUT=mxa-ocr-input
MINIO_BUCKET_OUTPUT=mxa-ocr-output
MINIO_SECURE=False
MINIO_REGION=us-east-1

# MinIO root/admin credentials (required for setup-minio.sh to create the app user)
# These must match the MINIO_ROOT_USER and MINIO_ROOT_PASSWORD configured on the
# MinIO server itself (e.g. set via docker run -e or docker-compose environment).
# setup-minio.sh reads these to provision MINIO_ACCESS_KEY/MINIO_SECRET_KEY via
# mc admin user add.  Without them the generated app credentials will be rejected.
MINIO_ROOT_USER=mxaadmin
MINIO_ROOT_PASSWORD=your-minio-root-password

# ----------------------------------------------------------------------------
# OCR Configuration
# ----------------------------------------------------------------------------
OCR_ENGINE=tesseract
OCR_DEFAULT_LANGUAGE=eng
OCR_LANGUAGES=eng,afr,ara,fra,deu,spa
OCR_DPI=300
OCR_TIMEOUT=900
TESSERACT_CMD=/usr/bin/tesseract

# ----------------------------------------------------------------------------
# File Processing
# ----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff,tif
TEMP_DIR=/tmp/mxa-ocr
OUTPUT_FORMATS=txt,pdf,json

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/mxa-ocr/backend.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------
API_KEY=optional-api-key-for-internal-auth
CORS_ORIGINS=https://ocr.gismartanalytics.com
CORS_ALLOW_CREDENTIALS=True

# ----------------------------------------------------------------------------
# Performance
# ----------------------------------------------------------------------------
WORKER_TIMEOUT=300
REQUEST_TIMEOUT=60
CONNECTION_POOL_SIZE=100

# ============================================================================
# IMPORTANT NOTES
# ============================================================================
# 1. This configuration is ONLY for the MXA OCR product
# 2. Do not share these values with other products
# 3. Change all passwords and secrets before deploying to production
# 4. Ensure file permissions are restrictive (chmod 600 .env)
# 5. Backup this file securely
# ============================================================================
